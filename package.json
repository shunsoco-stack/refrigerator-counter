{
  "name": "refrigerator-counter",
  "version": "1.0.0",
  "private": true,
  "description": "冷蔵庫を開けた回数だけを、真剣に記録するWebアプリ。",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/generate-assets.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "motion": "13.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
